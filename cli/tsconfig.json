{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "kdbxweb": ["./node_modules/kdbxweb"],
      "hash-wasm": ["./node_modules/hash-wasm"]
    }
  },
  "include": ["src", "test", "*.ts", "*.mjs"]
}
