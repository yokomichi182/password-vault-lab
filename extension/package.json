{
  "name": "pwvault-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:test": "node build.mjs --test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../cli/build.mjs && node build.mjs --test && playwright test",
    "serve:check": "node e2e/serve-check.ts",
    "scan:canary": "node ../worker/scripts/scan-canary.mjs"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.1.0",
    "@types/node": "^25.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
